@startuml Accountant Screen Layouts
!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam roundcorner 5

title Financial Reconciliation System - Accountant Screen Layouts (Mockups)

' ============================================
' Login Screen Layout
' ============================================
salt
{
  {T
    + <b>Login Screen (/login)</b>
    ++ <i>UC: User Authentication</i>
  }
  ====
  {
    <size:20><&person> FinRecon
    --
    [Language Switcher: EN | HE | AR ]
    --
    Email: | "                    "
    Password: | "                    "
    --
    Role Selection:
    {
      (*) Accountant
      ( ) Business Owner
      ( ) Admin
    }
    --
    [ <b>Login</b>                      ]
    --
    <i>Forgot Password?</i> | <i>Don't have account? Register</i>
  }
  ====
  <b>Actions:</b>
  * Enter email & password
  * Select role (Accountant)
  * Submit login → Navigate to Dashboard
}
----
' ============================================
' Dashboard Screen Layout
' ============================================
salt
{
  {T
    + <b>Dashboard (/dashboard)</b>
    ++ <i>UC: View Overview</i>
  }
  ====
  {
    {/ <b>Sidebar</b> | <b>Main Content</b>
    {
      <&home> Dashboard
      --
      <&briefcase> My Businesses
      --
      <b>Workflow</b>
      <&cloud-upload> Upload Invoices
      <&credit-card> Import Bank Data
      <&activity> Processing Status
      <&git-compare> Match & Reconcile
      <&download> Export Data
      --
      <b>Reports</b>
      <&file-text> Reports Dashboard
      <&file-text> VAT Reports
      <&alert-triangle> Anomaly Alerts
      --
      <b>Settings</b>
      <&person> Profile
      <&settings> AI Settings
      --
      <b>Help</b>
      <&help-circle> Help & Support
      <&book-open> Tutorial
      --
      <&log-out> Logout
    } |
    {
      {
        [Business Switcher ▼] | [🔔 Notifications] [Language: EN ▼]
      }
      --
      <b><size:18>Dashboard Overview</size></b>
      --
      {#
        <b>Total Invoices</b> | <b>Pending Matches</b> | <b>Processing</b> | <b>Completed</b>
        <size:24><color:blue>156</color></size> | <size:24><color:orange>23</color></size> | <size:24><color:purple>8</color></size> | <size:24><color:green>125</color></size>
      }
      --
      {#
        <b>Recent Activity</b> | <b>Quick Actions</b>
        {
          • Invoice #1234 matched
          • Bank import completed
          • VAT report generated
          • 3 new anomalies detected
        } |
        {
          [ <&cloud-upload> Upload Invoice ]
          [ <&credit-card> Import Bank Data ]
          [ <&git-compare> Match Transactions ]
          [ <&file-text> Generate Report ]
        }
      }
      --
      {#
        <b>Alerts & Notifications</b>
        ⚠ 5 unmatched transactions require attention
        ⚠ VAT report due in 3 days
        ✓ Monthly reconciliation complete
      }
    }
    }
  }
  ====
  <b>Actions:</b>
  * View statistics and KPIs
  * Check recent activity
  * Access quick actions
  * Review alerts
  * Switch active business context
}
