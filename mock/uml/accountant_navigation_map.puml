@startuml Accountant Navigation Map

skinparam backgroundColor #FEFEFE
skinparam roundcorner 10
skinparam shadowing false
skinparam componentStyle rectangle

title Financial Reconciliation System - Accountant Navigation Map

' Authentication Layer
component "Login Screen\n/login\n\nUC: User Authentication" as Login #FFE0B2
component "Register\n/register" as Register #FFE0B2
component "Forgot Password\n/forgot-password" as ForgotPwd #FFE0B2

' Main Dashboard
component "Dashboard\n/dashboard\n\nUC: View Overview" as Dashboard #C8E6C9

' Account Management
package "Account Management" #FFF9C4 {
    component "Manage Businesses\n/accountant/businesses\n\nUC: Manage Business Accounts" as ManageBiz
}

' Core Workflow
package "Core Workflow" #E1BEE7 {
    component "Invoice Upload\n/invoice-upload\n\nUC: Upload Invoices" as InvoiceUpload
    component "Bank Import\n/bank-import\n\nUC: Import Bank Data" as BankImport
    component "Processing Status\n/processing-status\n\nUC: Track Processing" as ProcessStatus
    component "Invoice Detail\n/invoice-detail/:id\n\nUC: View Invoice Details" as InvoiceDetail
    component "Matching & Reconciliation\n/matching\n\nUC: Match Transactions" as Matching
    component "Consolidated Export\n/export\n\nUC: Export Data" as Export
}

' Reports & Compliance
package "Reports & Compliance" #FFCCBC {
    component "Reports Dashboard\n/reports\n\nUC: View Reports Overview" as ReportsDash
    component "VAT Report\n/reports/vat\n\nUC: Generate VAT Report" as VATReport
    component "Anomaly Alerts\n/anomalies\n\nUC: Review Anomalies" as Anomalies
    component "Exception Detail\n/anomalies/:id\n\nUC: Resolve Exception" as ExceptionDetail
}

' Settings
package "Settings & Configuration" #B2DFDB {
    component "User Profile\n/profile\n\nUC: Manage Profile" as Profile
    component "AI Settings\n/ai-settings\n\nUC: Configure AI" as AISettings
}

' Help & Support
package "Help & Support" #F8BBD0 {
    component "Help & Support\n/help\n\nUC: Get Help" as Help
    component "Tutorial\n/tutorial\n\nUC: Learn System" as Tutorial
}

' Navigation Flows
Login --> Dashboard : Login Success
Login --> Register
Login --> ForgotPwd
Register --> Login

Dashboard --> ManageBiz
Dashboard --> InvoiceUpload
Dashboard --> BankImport
Dashboard --> ProcessStatus
Dashboard --> Matching
Dashboard --> ReportsDash
Dashboard --> Anomalies
Dashboard --> Profile
Dashboard --> AISettings
Dashboard --> Help
Dashboard --> Tutorial

InvoiceUpload --> ProcessStatus
InvoiceUpload --> InvoiceDetail
ProcessStatus --> InvoiceDetail
InvoiceDetail --> Matching
BankImport --> Matching
Matching --> Export

ReportsDash --> VATReport
ReportsDash --> Anomalies
Anomalies --> ExceptionDetail

legend right
    **Screen Types**
    <color:#FFE0B2>Authentication Screens</color>
    <color:#C8E6C9>Main Dashboard</color>
    <color:#FFF9C4>Account Management</color>
    <color:#E1BEE7>Core Workflow</color>
    <color:#FFCCBC>Reports & Compliance</color>
    <color:#B2DFDB>Settings</color>
    <color:#F8BBD0>Help & Support</color>
endlegend

@enduml
