# Environment Configuration
PORT=3000
NODE_ENV=development

# SQL Server Configuration
DB_SERVER=localhost
DB_PORT=50115
DB_DATABASE=FP
DB_USER=fpapp
DB_PASSWORD=FPApp2024!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Use Windows Authentication (set to true) or SQL Authentication (set to false)
