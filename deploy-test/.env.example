# Environment Variables (Example)

# Backend Configuration
NODE_ENV=production
PORT=3000

# AI Service URL (use service name in Docker, localhost for local dev)
AI_SERVICE_URL=http://ai-service:8000

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=deploytest
DB_USER=deployuser
DB_PASSWORD=deploypass

# ⚠️ IMPORTANT: Change DB_PASSWORD in production!
# Never commit real passwords to version control
